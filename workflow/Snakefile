# Load config only if not already loaded (e.g., when used as a module)
import sys
import os

if not config:  # config is empty when run standalone
    if "--configfile" in sys.argv:
        i = sys.argv.index("--configfile")
        config_path = sys.argv[i + 1]
        configfile: config_path
    else:
        config_path = "config/config.yaml"
        configfile: config_path

DATA_DIR = config["DATA_DIR"]
LOG_DIR = config["LOG_DIR"]
LOG_LEVEL = config["LOG_LEVEL"]
RIBONN_DATASETS = config["RIBONN_DATASETS"]
HCT116_ISOFORMS = config["HCT116_ISOFORMS"]
HCT116_ISOFORMS_TE = config["HCT116_ISOFORMS_TE"]
MIRNA_TARGETS = config["MIRNA_TARGETS"]
TARGETSCAN_URL = MIRNA_TARGETS["url"]
TARGETSCAN_SPECIES_ID = MIRNA_TARGETS["species_id"]
TARGETSCAN_TSV = os.path.join("resources", "Summary_Counts.default_predictions.txt")
TARGETSCAN_SCORE_COLUMNS = MIRNA_TARGETS["score_columns"]

include: "rules/HCT116_isoforms.smk"
include: "rules/RiboNN_data.smk"

rule all:
    input:
        # RiboNN translation efficiency datasets
        expand(
            os.path.join(DATA_DIR, "RiboNN_{dataset}_TE.csv"),
            dataset=RIBONN_DATASETS.keys()
        ),
        # HCT116 isoform metadata
        os.path.join(DATA_DIR, "HCT116_isoforms_metadata.csv"),
        # HCT116 translation efficiency measurements across conditions and timepoints
        expand(
            os.path.join(DATA_DIR, "HCT116_isoforms_TE_{condition}_{timepoint}.csv"),
            condition=HCT116_ISOFORMS_TE["conditions"],
            timepoint=HCT116_ISOFORMS_TE["timepoints"],
        ),
        # miRNA binding scores (context scores, conserved sites, weighted)
        expand(
            os.path.join(DATA_DIR, "HCT116_isoforms_miRNA_binding_scores_{score_name}.csv"), 
            score_name=TARGETSCAN_SCORE_COLUMNS.keys()
        )

rule download_targetscan_summary_counts:
    output:
        TARGETSCAN_TSV
    params:
        url=TARGETSCAN_URL
    conda:
        "envs/miRNA.yaml"
    log:
        os.path.join(LOG_DIR, "download_targetscan_summary_counts.log")
    script:
        "scripts/download_targetscan_summary_counts_default_predictions.py"

rule prepare_miRNA_binding_scores:
    input:
        input_csv=os.path.join(DATA_DIR, "HCT116_isoforms_metadata.csv"),
        targetscan_tsv=TARGETSCAN_TSV
    output:
        os.path.join(DATA_DIR, "HCT116_isoforms_miRNA_binding_scores_{score_name}.csv")
    params:
        score_column=lambda wildcards: TARGETSCAN_SCORE_COLUMNS[wildcards.score_name],
        species_id=TARGETSCAN_SPECIES_ID
    conda:
        "envs/miRNA.yaml"
    log:
        os.path.join(LOG_DIR, "prepare_miRNA_binding_scores_{score_name}.log")
    script:
        "scripts/prepare_targetscan_summary_counts_default_predictions_scores.py"
